{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/brunch.html",
      "destination": "/wedding-brunch.html",
      "permanent": true
    },
    {
      "source": "/private-venue-nevada-city",
      "destination": "/wedding-pricing",
      "permanent": true
    },
    {
      "source": "/private-venue-nevada-city/",
      "destination": "/wedding-pricing",
      "permanent": true
    },
    {
      "source": "/weddings",
      "destination": "/moments",
      "permanent": true
    },
    {
      "source": "/weddings/",
      "destination": "/moments/",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy/",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/terms/",
      "permanent": true
    },
    {
      "source": "/venue-pricing",
      "destination": "/venue-pricing/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "stonehouse.io"
        }
      ],
      "destination": "https://www.stonehouse.io/$1",
      "permanent": true
    },
    {
      "source": "/studio",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/studio/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/blog.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; img-src 'self' data: https://lh3.googleusercontent.com https://www.googletagmanager.com https://www.google-analytics.com https://*.facebook.com https://www.gstatic.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://app.hitched.us; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com https://*.facebook.com https://app.hitched.us; frame-src 'self' https://app.hitched.us https://hitched.us; object-src 'none'; base-uri 'self'; form-action 'self' https://app.hitched.us"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}